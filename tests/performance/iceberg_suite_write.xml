<!-- https://clickhouse.com/docs/getting-started/example-datasets/tpch -->
<!-- Scale factor: 10 -->
<test run_all_queries="1">
    <settings>
        <allow_insert_into_iceberg>1</allow_insert_into_iceberg>
        <mutations_sync>2</mutations_sync>
        <iceberg_metadata_log_level>none</iceberg_metadata_log_level>
        <iceberg_delete_data_on_drop>1</iceberg_delete_data_on_drop>
    </settings>

    <!-- WRITE suite: one `lineitem`-shaped `IcebergLocal` table fed from the CI-attached `tpch10`
         dataset. With `run_all_queries` the queries execute in file order, so they form a
         deterministic pipeline: each stage runs over the state the previous stages left, and both
         servers walk that state in lockstep (every run of every query executes on both), which is
         what keeps the comparison of modifying queries fair. -->

    <substitutions>
        <substitution>
            <name>database</name>
            <values>
                <value>iceberg_suite_write</value>
            </values>
        </substitution>
    </substitutions>

    <create_query>CREATE DATABASE IF NOT EXISTS {database}</create_query>
    <create_query>DROP TABLE IF EXISTS {database}.lineitem</create_query>

    <!-- Measures are `Float64` and fixed text is `String` because `Iceberg::getIcebergType` maps
         neither `Decimal` nor `FixedString`. -->
    <create_query>
        CREATE TABLE {database}.lineitem
        (
            l_orderkey Int32, l_partkey Int32, l_suppkey Int32, l_linenumber Int32,
            l_quantity Float64, l_extendedprice Float64, l_discount Float64, l_tax Float64,
            l_returnflag String, l_linestatus String,
            l_shipdate Date, l_commitdate Date, l_receiptdate Date,
            l_shipinstruct String, l_shipmode String, l_comment String
        )
        ENGINE = IcebergLocal((SELECT value FROM system.server_settings WHERE name = 'user_files_path') || '/iceberg_suite_write_lineitem_' || toString(toUnixTimestamp64Micro(now64(6))) || '/', 'Parquet')
    </create_query>

    <!-- insert_large: a 100K-row prefix of `lineitem` SF10 as one ordered stream, one block,
         one commit; `max_threads = 1` pins the row set across servers. Each run appends the same
         rows and one snapshot, so the per-run cost is dominated by the Parquet encoding, not by
         the growing metadata. -->
    <query>
        INSERT INTO {database}.lineitem SELECT * FROM tpch10.lineitem LIMIT 100000
        SETTINGS max_threads = 1, max_insert_threads = 1,
                 min_insert_block_size_rows = 100000, min_insert_block_size_bytes = 0
    </query>

    <!-- insert_small_commits: 10 tiny commits per run, so the payload (100 rows of Parquet) is
         comparable to the metadata written per commit (metadata.json, manifest, manifest list).
         The commits land on the shared table, so the snapshot history deepens by 10 per run:
         the per-commit metadata cost grows with it, which both servers experience in lockstep,
         and it leaves the later stages a realistically deep history to plan over. Parameter
         substitution and <settings> do not apply to shell scripts, hence the literal database
         name and the inline client flag. -->
    <query type="shell">
seq 1 10 | while read i; do
    echo "INSERT INTO iceberg_suite_write.lineitem SELECT * FROM tpch10.lineitem LIMIT 100 SETTINGS max_threads = 1, max_insert_threads = 1;"
done | $CLICKHOUSE_CLIENT --allow_insert_into_iceberg=1
    </query>

    <!-- optimize_table: must run while the snapshot history is still append-only, because the
         compaction plan replays it and `tryGetAppendUpdate` throws on the `overwrite` snapshots
         the UPDATE stages commit. With no position-delete files the plan finds nothing to rewrite
         (`need_optimize` stays false), so every run measures the planning pass: reading every
         manifest of every snapshot accumulated by the insert stages. -->
    <query>OPTIMIZE TABLE {database}.lineitem SETTINGS allow_experimental_iceberg_compaction = 1</query>

    <!-- update_no_match: the mutation planning over every data file; the predicate is pruned by
         the column statistics, so nothing is scanned or rewritten and the state stays stable from
         run to run. Zero-match mutations commit no snapshot. -->
    <query>ALTER TABLE {database}.lineitem UPDATE l_quantity = l_quantity + 1 WHERE l_partkey &lt; 0</query>

    <!-- update_every_file: `l_partkey % 10` is scattered over every data file, so the mutation
         scans everything and rewrites the matched rows. The first mutation on an append-only
         history is cheap and is absorbed by the prewarm; every later run pays the full history
         replay over the `overwrite` snapshots the previous runs committed, which is the steady
         state this query measures. -->
    <query>ALTER TABLE {database}.lineitem UPDATE l_quantity = l_quantity + 1 WHERE l_partkey % 10 = 0</query>

    <!-- modify_column: Iceberg schema evolution is a pure metadata commit and creates no
         snapshot. The first run performs the real `Int32 -> Int64` promotion; every later run
         re-commits the same type, which walks the identical read-generate-write metadata path
         (`allowPrimitiveTypeConversion` accepts `old == new`) and appends one more schema entry. -->
    <query>ALTER TABLE {database}.lineitem MODIFY COLUMN l_suppkey Int64</query>

    <!-- optimize_manifests: unlike the data compaction above, this tolerates the mutation
         snapshots. The lowered threshold makes the first run consolidate the manifests
         accumulated by the pipeline; the later runs measure the manifest-list read and the
         threshold check that returns early. -->
    <query>
        OPTIMIZE TABLE {database}.lineitem MANIFEST
        SETTINGS allow_experimental_iceberg_compaction = 1, iceberg_manifest_min_count_to_compact = 8
    </query>

    <drop_query>DROP TABLE IF EXISTS {database}.lineitem</drop_query>
</test>
